---
const base = import.meta.env.BASE_URL;
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur border-b border-slate-800">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href={base} class="text-xl font-bold tracking-wide">
      DJL
    </a>

    <div class="flex items-center gap-6 text-sm font-medium text-slate-300">
      <a href={`${base}#about`} class="hover:text-cyan-400">About</a>
      <a href={`${base}#skills`} class="hover:text-cyan-400">Skills</a>
      <a href={`${base}#projects`} class="hover:text-cyan-400">Projects</a>
      <a href={`${base}#architecture`} class="hover:text-cyan-400">Architecture</a>
      <a href={`${base}resume`} class="hover:text-cyan-400">Resume</a>
    </div>
  </div>
</nav>

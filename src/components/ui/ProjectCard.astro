---
interface Props {
  title: string;
  description: string;
  technologies: string[];
}

const { title, description, technologies } = Astro.props;
---

<div class="rounded-xl border border-slate-800 bg-slate-900 p-6 transition hover:border-cyan-400 hover:shadow-lg">
  <h3 class="text-2xl font-bold">{title}</h3>

  <p class="mt-4 text-slate-400">
    {description}
  </p>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      technologies.map((tech) => (
        <span class="rounded bg-slate-800 px-3 py-1 text-sm">
          {tech}
        </span>
      ))
    }
  </div>
</div>

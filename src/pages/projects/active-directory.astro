---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Enterprise Active Directory">

<section class="mx-auto max-w-6xl px-6 py-24">

    <h1 class="text-5xl font-bold">
        Enterprise Active Directory
    </h1>

    <p class="mt-6 text-lg text-slate-400">
        Designed and deployed a redundant Microsoft Active Directory
        environment for an enterprise homelab using Windows Server 2025.
    </p>

    <img
      src={`${base}/images/network-topology.png`}
        alt="Enterprise Network"
        class="mt-12 rounded-xl border border-slate-800 shadow-2xl"
    />

    <div class="mt-12 space-y-10">

        <section>
            <h2 class="text-3xl font-bold">
                Project Overview
            </h2>

            <p class="mt-4 leading-8 text-slate-400">
                This project demonstrates the deployment of a secure enterprise
                Active Directory infrastructure with centralized identity,
                authentication, DNS, DHCP and Group Policy management.
            </p>
        </section>

        <section>
            <h2 class="text-3xl font-bold">
                Technologies Used
            </h2>

            <div class="mt-6 flex flex-wrap gap-3">

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Windows Server 2025
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Active Directory
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    DNS
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    DHCP
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Group Policy
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    PowerShell
                </span>

            </div>
        </section>

        <section>

            <h2 class="text-3xl font-bold">
                Infrastructure
            </h2>

            <ul class="mt-6 list-disc space-y-2 pl-6 text-slate-400">

                <li>2 Domain Controllers</li>
                <li>DNS Services</li>
                <li>DHCP Services</li>
                <li>Active Directory Sites &amp; Services</li>
                <li>Organizational Units</li>
                <li>Group Policies</li>
                <li>User &amp; Computer Management</li>

            </ul>

        </section>

    </div>

</section>

</BaseLayout>

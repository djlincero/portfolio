---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Enterprise Monitoring Stack">

<section class="mx-auto max-w-6xl px-6 py-24">

    <h1 class="text-5xl font-bold">
        Enterprise Monitoring Stack
    </h1>

    <p class="mt-6 text-lg text-slate-400">
        Built a centralized monitoring and security platform using Prometheus,
        Grafana, and Wazuh to monitor servers, services, infrastructure health,
        and security events across the enterprise homelab.
    </p>

    <img
       src={`${base}/images/network-topology.png`}
        alt="Enterprise Monitoring"
        class="mt-12 rounded-xl border border-slate-800 shadow-2xl"
    />

    <div class="mt-12 space-y-10">

        <section>
            <h2 class="text-3xl font-bold">
                Project Overview
            </h2>

            <p class="mt-4 leading-8 text-slate-400">
                Designed and deployed a complete enterprise monitoring solution
                providing real-time infrastructure metrics, visualization,
                alerting, and endpoint security monitoring.
            </p>
        </section>

        <section>

            <h2 class="text-3xl font-bold">
                Technologies Used
            </h2>

            <div class="mt-6 flex flex-wrap gap-3">

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Grafana
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Prometheus
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Wazuh
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Node Exporter
                </span>

                <span class="rounded bg-cyan-600 px-4 py-2">
                    Alertmanager
                </span>

            </div>

        </section>

        <section>

            <h2 class="text-3xl font-bold">
                Features
            </h2>

            <ul class="mt-6 list-disc space-y-2 pl-6 text-slate-400">

                <li>Infrastructure Monitoring</li>
                <li>Performance Metrics</li>
                <li>Real-Time Dashboards</li>
                <li>Security Event Monitoring</li>
                <li>Log Collection</li>
                <li>Alerting &amp; Notifications</li>
                <li>Endpoint Monitoring</li>

            </ul>

        </section>

    </div>

</section>

</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Resume | Roscelin Nguefack">

<section class="mx-auto max-w-6xl px-6 py-24">

  <h1 class="text-5xl font-bold">
    Resume
  </h1>

  <p class="mt-4 text-slate-400">
    View my resume below or download a copy.
  </p>

  <div class="mt-8">
    <a
      href={`${base}resume.pdf`}
      target="_blank"
      class="rounded-lg bg-cyan-500 px-6 py-3 font-semibold text-slate-950 hover:bg-cyan-400"
    >
      Download Resume
    </a>
  </div>

  <div class="mt-12 overflow-hidden rounded-xl border border-slate-800">

    <iframe
      src={`${base}resume.pdf`}
      class="h-[1000px] w-full"
      title="Resume"
    ></iframe>

  </div>

</section>

</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Resume | Roscelin Nguefack">

<section class="mx-auto max-w-6xl px-6 py-24">

  <h1 class="text-5xl font-bold">
    Resume
  </h1>

  <p class="mt-4 text-slate-400">
    View my resume below or download a copy.
  </p>

  <div class="mt-8">
    <a
      href="/resume.pdf"
      target="_blank"
      class="rounded-lg bg-cyan-500 px-6 py-3 font-semibold text-slate-950 hover:bg-cyan-400"
    >
      Download Resume
    </a>
  </div>

  <div class="mt-12 rounded-xl overflow-hidden border border-slate-800">

    <iframe
      src="/resume.pdf"
      class="w-full h-[1000px]"
      title="Resume"
    ></iframe>

  </div>

</section>

</BaseLayout>
